{
  "expo": {
    "name": "TheKabadiwala",
    "slug": "thekabadiwala",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thekabadiwala",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thekabadiwala.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "TheKabadiwala needs camera access to take photos of your scrap items for pickup.",
        "NSPhotoLibraryUsageDescription": "TheKabadiwala needs photo library access to attach pictures of your scrap items.",
        "NSLocationWhenInUseUsageDescription": "TheKabadiwala needs location access to find scrap collectors near you.",
        "NSLocationAlwaysUsageDescription": "TheKabadiwala needs location access to find scrap collectors near you."
      }
    },
    "android": {
      "package": "com.thekabadiwala.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#E8F5E9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TheKabadiwala needs access to your photos to attach scrap item images.",
          "cameraPermission": "TheKabadiwala needs camera access to take photos of your scrap items."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "googlePlacesApiKey": "",
      "eas": {
        "projectId": "b6a8d931-8434-4008-a3f2-d1aae41a314a"
      }
    },
    "owner": "vizi_kids_eas_001"
  }
}
